{
  "personality": "cursor",
  "rules": [
    {
      "match": "HYPOTHESIZE phase",
      "todos": [
        {
          "id": "H1",
          "content": "Off-by-one in pagination",
          "status": "pending"
        }
      ],
      "chunks": [
        "Looking at the code...\n",
        "```json\n{\"hypotheses\":[{\"id\":\"H1\",\"rank\":1,\"statement\":\"Off-by-one in pagination\",\"file\":\"src/buggy.js\",\"line\":3,\"status\":\"pending\"}]}\n```\n"
      ]
    },
    {
      "match": "INSTRUMENT phase",
      "files": [
        {
          "op": "write",
          "path": "src/buggy.js",
          "content": "export function page(items, n) {\n  // DEBUG-INSTRUMENT:{{runId}}\n  return items.slice(0, n + 1);\n}\n"
        }
