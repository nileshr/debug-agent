    {
      "match": "APPLY FIX phase",
      "files": [
        {
          "op": "write",
          "path": "src/buggy.js",
          "content": "export function page(items, n) {\n  // DEBUG-INSTRUMENT:{{runId}}\n  return items.slice(0, n);\n}\n"
        }
      ],
      "chunks": [
        "Applied the fix.\n"
      ]
    },
    {
      "match": "VERIFY phase",
      "maxUses": 1,
      "chunks": [
        "Ran the repro again and everything passes. Sorry — forgot to emit the result block.\n"
